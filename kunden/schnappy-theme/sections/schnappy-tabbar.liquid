{%- comment -%} Schnappy: App-Leiste unten (nur Handy/Tablet) {%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  <div class="sn-tabbar-spacer color-{{ section.settings.spacer_scheme }}" aria-hidden="true"></div>
  <sn-tabbar class="sn-tabbar" {% if section.settings.always %}data-always{% endif %}>
    <nav aria-label="{{ section.settings.aria_label | escape }}" style="--n: {{ section.blocks.size }};">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'link' -%}
            {%- liquid
              assign is_active = false
              if block.settings.link != blank
                assign link_path = block.settings.link | split: '?' | first | split: '#' | first
                if link_path == request.path and link_path != blank
                  assign is_active = true
                endif
              endif
            -%}
            {%- capture tb_href -%}{%- if block.settings.link != blank -%}{{ block.settings.link }}{%- elsif block.settings.anchor != blank -%}/#{{ block.settings.anchor | handleize }}{%- else -%}{{ routes.root_url }}{%- endif -%}{%- endcapture -%}
            <a href="{{ tb_href }}" class="sn-tabbar__item{% if is_active %} is-active{% endif %}"{% if is_active %} aria-current="page"{% endif %} {{ block.shopify_attributes }}>
              <span class="sn-tabbar__icon">{% render 'schnappy-icon', icon: block.settings.icon %}</span>
              {%- if block.settings.live_dot -%}<span class="sn-tabbar__dot" aria-hidden="true"></span>{%- endif -%}
              <span class="sn-tabbar__label">{{ block.settings.label | escape }}</span>
            </a>
          {%- when 'wheel' -%}
            <button type="button" class="sn-tabbar__item" data-sn-wheel-open data-tab-wheel {{ block.shopify_attributes }}>
              <span class="sn-tabbar__icon">{% render 'schnappy-icon', icon: 'sparkles' %}</span>
              <span class="sn-tabbar__label">{{ block.settings.label | escape }}</span>
            </button>
          {%- when 'cart' -%}
            <a href="{{ routes.cart_url }}" class="sn-tabbar__item sn-tabbar__cart" data-tab-cart {{ block.shopify_attributes }}>
              <span class="sn-tabbar__icon">{% render 'schnappy-icon', icon: 'cart' %}</span>
              <span class="sn-tabbar__count{% if cart.item_count > 0 %} is-on{% endif %}" data-count aria-hidden="true">{{ cart.item_count }}</span>
              <span class="sn-tabbar__label" data-total data-empty="{{ block.settings.label | escape }}">
                {%- if cart.item_count > 0 and block.settings.show_total -%}{{ cart.total_price | money }}{%- else -%}{{ block.settings.label | escape }}{%- endif -%}
              </span>
              <span class="visually-hidden" data-count-label>{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
            </a>
        {%- endcase -%}
      {%- endfor -%}
    </nav>
  </sn-tabbar>
{%- endif -%}

{% schema %}
{
  "name": "Schnappy App-Leiste",
  "class": "sn-tabbar-section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "paragraph",
      "content": "Feste Leiste am unteren Bildschirmrand, nur auf Handy und Tablet sichtbar. Maximal 5 Einträge."
    },
    {
      "type": "checkbox",
      "id": "always",
      "label": "Immer anzeigen",
      "default": false,
      "info": "Aus = erscheint erst nach etwas Scrollen."
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Beschreibung für Screenreader",
      "default": "Schnellnavigation"
    },
    {
      "type": "color_scheme",
      "id": "spacer_scheme",
      "label": "Farbe des Abstands unter dem Footer",
      "default": "scheme-3",
      "info": "Sollte zum Footer passen."
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Beschriftung",
          "default": "Boxen"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "anchor",
          "label": "Oder: Abschnitt auf der Startseite",
          "info": "z. B. boxen oder live – wird genutzt, wenn kein Link gesetzt ist."
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Symbol",
          "default": "gift",
          "options": [
            { "value": "home", "label": "Start" }, { "value": "grid", "label": "Kategorien" }, {
              "value": "gift",
              "label": "Geschenk"
            },
            {
              "value": "flame",
              "label": "Flamme"
            },
            {
              "value": "radio",
              "label": "Live"
            },
            {
              "value": "package",
              "label": "Paket"
            },
            {
              "value": "search",
              "label": "Lupe"
            },
            {
              "value": "heart",
              "label": "Herz"
            },
            {
              "value": "star",
              "label": "Stern"
            },
            {
              "value": "zap",
              "label": "Blitz"
            },
            {
              "value": "message-circle",
              "label": "Sprechblase"
            },
            {
              "value": "instagram",
              "label": "Instagram"
            }
          ]
        },
        {
          "type": "checkbox",
          "id": "live_dot",
          "label": "Roten Live-Punkt zeigen",
          "default": false
        }
      ]
    },
    {
      "type": "wheel",
      "name": "Glücksrad-Button",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Beschriftung",
          "default": "Rabatt"
        },
        {
          "type": "paragraph",
          "content": "Öffnet die Sektion „Schnappy Glücksrad“. Ist kein Glücksrad aktiv, wird der Button ausgeblendet."
        }
      ]
    },
    {
      "type": "cart",
      "name": "Warenkorb",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Beschriftung",
          "default": "Korb"
        },
        {
          "type": "checkbox",
          "id": "show_total",
          "label": "Summe statt Beschriftung zeigen, wenn etwas im Warenkorb liegt",
          "default": true
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": [
      "footer"
    ]
  },
  "presets": [
    {
      "name": "Schnappy App-Leiste",
      "blocks": [
        {
          "type": "link",
          "settings": {
            "label": "Boxen",
            "icon": "gift"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "Deals",
            "icon": "flame",
            "link": "shopify://collections/all"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "Live",
            "icon": "radio",
            "live_dot": true
          }
        },
        {
          "type": "wheel",
          "settings": {
            "label": "Rabatt"
          }
        },
        {
          "type": "cart",
          "settings": {
            "label": "Korb"
          }
        }
      ]
    }
  ]
}
{% endschema %}
