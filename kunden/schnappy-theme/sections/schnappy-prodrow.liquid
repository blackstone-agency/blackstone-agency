{%- comment -%}
  Schnappy: Produktreihe (z. B. Bestseller, Unter 5 €). Die Produkte werden live nach Shopify-Sortierung geladen.
{%- endcomment -%}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'quick-add.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign q = section.settings.query | default: 'sort_by=best-selling'
  assign t = section.settings.title
  assign skip = false
  if product
    assign ptype = product.type | default: ''
    if q contains '{type}' and ptype == blank
      assign skip = true
    endif
    assign pmax = product.price | divided_by: 100 | plus: 1
    if pmax <= 50
      assign pmax = pmax | plus: 4 | divided_by: 5 | times: 5
    else
      assign pmax = pmax | plus: 9 | divided_by: 10 | times: 10
    endif
    assign q = q | replace: '{type}', ptype | replace: '{price}', pmax
    assign t = t | replace: '{type}', ptype | replace: '{price}', pmax
  endif
  assign base = routes.all_products_collection_url
  if q contains 'q='
    assign base = routes.search_url
  endif
  assign all_url = base | append: '?' | append: q
-%}
{%- unless skip -%}
<sn-row class="sn-row page-width" data-url="{{ base }}?{{ q }}&section_id=schnappy-bestgrid">
  <div class="sn-row__head">
    <h2 class="sn-row__title">{%- if section.settings.icon != blank -%}{% render 'schnappy-icon', icon: section.settings.icon %}{%- endif -%}{{ t | escape }}</h2>
    <div class="sn-row__right">
      <a class="sn-row__all" href="{{ all_url }}">Alle ansehen →</a>
      <div class="sn-row__nav" aria-hidden="true">
        <button type="button" class="sn-row__btn" data-prev tabindex="-1">‹</button>
        <button type="button" class="sn-row__btn" data-next tabindex="-1">›</button>
      </div>
    </div>
  </div>
  <div class="sn-row__body" data-body>
    <ul class="sn-row__list sn-row__list--skeleton" role="list" aria-hidden="true">
      {%- for i in (1..5) -%}<li class="sn-row__item"><div class="sn-skel"></div></li>{%- endfor -%}
    </ul>
  </div>
</sn-row>
{%- endunless -%}
{% schema %}
{
  "name": "Schnappy Produktreihe",
  "tag": "section",
  "class": "section sn-row-section",
  "settings": [
    { "type": "text", "id": "title", "label": "Überschrift", "default": "Bestseller" },
    { "type": "select", "id": "icon", "label": "Symbol", "default": "flame", "options": [ { "value": "", "label": "Keins" }, { "value": "flame", "label": "Flamme" }, { "value": "tag", "label": "Preisschild" }, { "value": "star", "label": "Stern" }, { "value": "sparkles", "label": "Funkeln" } ] },
    { "type": "text", "id": "query", "label": "Sortierung/Filter", "default": "sort_by=best-selling", "info": "z. B. sort_by=best-selling oder filter.v.price.lte=5. Auf Produktseiten: {type} = Produkttyp, {price} = Preis. Mit q=… wird die Suche genutzt." }
  ],
  "presets": [{ "name": "Schnappy Produktreihe" }]
}
{% endschema %}
