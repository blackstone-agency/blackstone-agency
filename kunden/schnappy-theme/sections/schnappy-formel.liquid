{%- comment -%} Schnappy: "Warum so günstig?" – nummerierte Schritte {%- endcomment -%}
<div class="sn-sec color-{{ section.settings.color_scheme }} gradient" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.kicker != blank or section.settings.text != blank -%}
      <div class="sn-head{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        <div>
          {%- if section.settings.kicker != blank -%}<p class="sn-kicker">{{ section.settings.kicker | escape }}</p>{%- endif -%}
          {%- if section.settings.heading != blank -%}<h2 class="sn-display sn-head__title">{{ section.settings.heading | escape | newline_to_br }}</h2>{%- endif -%}
        </div>
        {%- if section.settings.text != blank -%}<p class="sn-head__text">{{ section.settings.text | escape }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="sn-steps" style="--n: {{ section.blocks.size | at_most: 4 }};">
        {%- for block in section.blocks -%}
          <div class="sn-step color-{{ section.settings.card_scheme }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" {% if settings.animations_reveal_on_scroll %}data-cascade style="--animation-order: {{ forloop.index }};"{% endif %} {{ block.shopify_attributes }}>
            <span class="sn-step__n" aria-hidden="true">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
            <span class="sn-step__icon" aria-hidden="true">{% render 'schnappy-icon', icon: block.settings.icon %}</span>
            <h3 class="sn-step__title">{{ block.settings.title | escape | newline_to_br }}</h3>
            {%- if block.settings.text != blank -%}<p>{{ block.settings.text | escape }}</p>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Schnappy Formel",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kleine Überschrift", "default": "Die Schnappy-Formel" },
    { "type": "textarea", "id": "heading", "label": "Überschrift", "default": "Warum so\ngünstig?", "info": "Zeilenumbruch mit Enter." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Kein Trick, sondern Einkauf: Wir sichern uns Restposten, Überhänge und Retouren großer Händler und geben den Preisvorteil direkt an dich weiter." },
    { "type": "header", "content": "Design" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Farbschema", "default": "scheme-1" },
    { "type": "color_scheme", "id": "card_scheme", "label": "Farbschema der Karten", "default": "scheme-2" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Abstand oben", "default": 96 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Abstand unten", "default": 96 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Schritt",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Symbol", "default": "package",
          "options": [
            { "value": "package", "label": "Paket" },
            { "value": "shield-check", "label": "Schild mit Haken" },
            { "value": "sparkles", "label": "Funkeln" },
            { "value": "truck", "label": "Lieferwagen" },
            { "value": "gift", "label": "Geschenk" },
            { "value": "zap", "label": "Blitz" },
            { "value": "flame", "label": "Flamme" },
            { "value": "star", "label": "Stern" },
            { "value": "heart", "label": "Herz" },
            { "value": "radio", "label": "Live" },
            { "value": "search", "label": "Lupe" },
            { "value": "lock", "label": "Schloss" }
          ]
        },
        { "type": "textarea", "id": "title", "label": "Titel", "default": "Wir kaufen\nim großen Stil" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Paletten-Ware aus Restposten und Überproduktion, direkt aus Lagern in Europa." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Schnappy Formel",
      "blocks": [
        { "type": "step", "settings": { "icon": "package", "title": "Wir kaufen\nim großen Stil", "text": "Paletten-Ware aus Restposten und Überproduktion, direkt aus Lagern in Europa." } },
        { "type": "step", "settings": { "icon": "shield-check", "title": "Jedes Teil\nwird geprüft", "text": "Sortiert, kontrolliert und sauber verpackt, damit nur gute Ware bei dir landet." } },
        { "type": "step", "settings": { "icon": "sparkles", "title": "Du sparst\nbis zu 70 %", "text": "Festpreis im Shop oder Schnapper per Auktion in der Live-Show." } }
      ]
    }
  ]
}
{% endschema %}
