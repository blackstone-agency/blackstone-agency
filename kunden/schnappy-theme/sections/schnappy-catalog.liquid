{%- comment -%}
  Schnappy Katalog: alle Produkte als ruhiges Raster, beim Scrollen wird automatisch nachgeladen.
  Nachladen: <kollektion>?page=N&section_id=schnappy-catalog (gleiche Sortierung wie die Kollektion).
{%- endcomment -%}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'quick-add.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
{%- liquid
  if collection
    assign sn_src = collection
  else
    assign sn_src = collections.all
    assign sn_pick = section.settings.collection
    comment
      Gewählte Kollektion nur nutzen, wenn sie das ganze Sortiment enthält –
      sonst fehlen Artikel auf der Startseite (dann alle Produkte zeigen).
    endcomment
    if sn_pick != blank and sn_pick.products_count >= collections.all.products_count
      assign sn_src = sn_pick
    endif
  endif
-%}
<div id="produkte" class="sn-cat color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="sn-cat__head">
      <h2 class="sn-cat__title">{{ section.settings.heading | escape }} <span>{{ sn_src.products_count }} Artikel</span></h2>
      <nav class="sn-cat__sort" aria-label="Sortieren und filtern">
        <a href="{{ sn_src.url }}?sort_by=created-descending">Neu</a>
        <a href="{{ sn_src.url }}?sort_by=best-selling">Beliebt</a>
        <a href="{{ sn_src.url }}?sort_by=price-ascending">Günstigste</a>
        <a href="{{ sn_src.url }}?filter.v.price.lte=5&amp;sort_by=price-descending">Bis 5 €</a>
        <a href="{{ sn_src.url }}?filter.v.price.lte=10&amp;sort_by=price-descending">Bis 10 €</a>
        <a href="{{ sn_src.url }}">Filtern</a>
      </nav>
      <div class="sn-cat__mbtns">
        <button type="button" class="sn-cat__mbtn" data-sn-open-menu>{% render 'schnappy-icon', icon: 'grid' %}Kategorien</button>
        <a class="sn-cat__mbtn" href="{{ sn_src.url }}">{% render 'schnappy-icon', icon: 'search' %}Filtern &amp; Sortieren</a>
      </div>
    </div>
    {%- paginate sn_src.products by section.settings.per_page -%}
      <ul id="product-grid" class="grid product-grid grid--2-col-tablet-down grid--5-col-desktop sn-cat__grid" role="list">
        {%- for product in sn_src.products -%}
          {%- liquid
            assign sn_lazy = false
            if forloop.index > 4
              assign sn_lazy = true
            endif
          -%}
          <li class="grid__item">
            {% render 'card-product',
              card_product: product,
              media_aspect_ratio: 'square',
              image_shape: 'default',
              show_secondary_image: false,
              show_vendor: false,
              show_rating: false,
              lazy_load: sn_lazy,
              quick_add: 'standard',
              section_id: section.id,
              product_view_context: 'collection'
            %}
          </li>
        {%- endfor -%}
      </ul>
      {%- if paginate.next -%}
        {%- assign sn_page = paginate.current_page | plus: 1 -%}
        <sn-infinite data-next="{{ sn_src.url }}?page={{ sn_page }}&amp;section_id=schnappy-catalog" class="sn-infinite">
          <span class="sn-infinite__spinner" aria-hidden="true"></span>
          <a href="{{ sn_src.url }}?page={{ sn_page }}" class="sn-infinite__more button button--secondary">Weitere Produkte laden</a>
        </sn-infinite>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "Schnappy Alle Produkte",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Alle Produkte" },
    { "type": "collection", "id": "collection", "label": "Kollektion", "info": "Leer = alle Produkte. Tipp: eine Kollektion mit Sortierung „Neueste“ wählen." },
    { "type": "range", "id": "per_page", "label": "Produkte pro Ladeschritt", "min": 12, "max": 48, "step": 6, "default": 30 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Farbschema", "default": "scheme-1" }
  ],
  "presets": [{ "name": "Schnappy Alle Produkte" }]
}
{% endschema %}
