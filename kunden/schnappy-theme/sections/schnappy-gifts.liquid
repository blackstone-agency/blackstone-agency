{%- comment -%} Schnappy: Geschenkideen & Preis-Kacheln {%- endcomment -%}
<div class="page-width sn-gifts">
  <div class="sn-shophead"><h2 class="h2">{{ section.settings.heading | escape }}</h2></div>
  <ul class="sn-gifts__grid" role="list">
    {%- for block in section.blocks -%}
      {%- capture href -%}{%- if block.settings.link != blank -%}{{ block.settings.link }}{%- elsif block.settings.query != blank -%}{{ routes.search_url }}?type=product&q={{ block.settings.query | url_encode }}{% if block.settings.max > 0 %}&filter.v.price.lte={{ block.settings.max }}{% endif %}{%- else -%}{{ routes.all_products_collection_url }}{% if block.settings.max > 0 %}?filter.v.price.lte={{ block.settings.max }}&sort_by=price-descending{% endif %}{%- endif -%}{%- endcapture -%}
      <li {{ block.shopify_attributes }}>
        <a class="sn-gifts__tile sn-gifts__tile--{{ forloop.index | modulo: 4 }}" href="{{ href }}">
          <span class="sn-gifts__ic">{% render 'schnappy-icon', icon: block.settings.icon %}</span>
          <span class="sn-gifts__t">{{ block.settings.title | escape }}</span>
          {%- if block.settings.max > 0 -%}<span class="sn-gifts__p">unter {{ block.settings.max }} €</span>{%- endif -%}
        </a>
      </li>
    {%- endfor -%}
  </ul>
</div>
{% schema %}
{
  "name": "Schnappy Geschenkideen",
  "tag": "section",
  "class": "section",
  "max_blocks": 8,
  "settings": [ { "type": "text", "id": "heading", "label": "Überschrift", "default": "Geschenkideen nach Preis" } ],
  "blocks": [ { "type": "idea", "name": "Idee", "settings": [
    { "type": "text", "id": "title", "label": "Titel", "default": "Für Kinder" },
    { "type": "text", "id": "query", "label": "Suchbegriff", "default": "spielzeug" },
    { "type": "number", "id": "max", "label": "Unter … € (0 = egal)", "default": 15 },
    { "type": "select", "id": "icon", "label": "Symbol", "default": "gift", "options": [ { "value": "gift", "label": "Geschenk" }, { "value": "toy-brick", "label": "Spielzeug" }, { "value": "cooking-pot", "label": "Küche" }, { "value": "headphones", "label": "Technik" }, { "value": "lamp", "label": "Wohnen" }, { "value": "sparkles", "label": "Trend" }, { "value": "baby", "label": "Baby" }, { "value": "tag", "label": "Preis" } ] },
    { "type": "url", "id": "link", "label": "Eigener Link (optional)" }
  ] } ],
  "presets": [{ "name": "Schnappy Geschenkideen" }]
}
{% endschema %}
