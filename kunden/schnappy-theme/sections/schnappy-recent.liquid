<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- comment -%} Schnappy: Zuletzt angesehen – erscheint nur, wenn der Besucher schon Produkte angesehen hat {%- endcomment -%}
<sn-recent class="sn-recent page-width" data-current="{{ product.handle }}" hidden>
  <div class="sn-recent__head">
    <h2 class="sn-recent__title">{% render 'schnappy-icon', icon: 'rotate-ccw' %} {{ section.settings.heading | escape }}</h2>
    <button type="button" class="sn-recent__clear" data-clear>Verlauf löschen</button>
  </div>
  <ul class="sn-recent__list" role="list" data-list></ul>
</sn-recent>

{% schema %}
{
  "name": "Zuletzt angesehen",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Zuletzt angesehen" }
  ],
  "presets": [{ "name": "Zuletzt angesehen" }]
}
{% endschema %}
