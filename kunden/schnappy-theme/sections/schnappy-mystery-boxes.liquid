{%- comment -%} Schnappy: Box-Auswahl (S/M/XXL) mit 3D-Box, Wertanzeige und Warenkorb {%- endcomment -%}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign visible = 0
  for block in section.blocks
    if block.settings.product != blank or request.design_mode
      assign visible = visible | plus: 1
    endif
  endfor
-%}
{%- if visible > 0 -%}
  <div {% if section.settings.anchor != blank %}id="{{ section.settings.anchor | handleize }}" {% endif %}class="sn-sec color-{{ section.settings.color_scheme }} gradient" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
    <div class="page-width">
      {%- if section.settings.heading != blank or section.settings.kicker != blank or section.settings.text != blank -%}
        <div class="sn-head{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          <div>
            {%- if section.settings.kicker != blank -%}<p class="sn-kicker">{{ section.settings.kicker | escape }}</p>{%- endif -%}
            {%- if section.settings.heading != blank -%}<h2 class="sn-display sn-head__title">{{ section.settings.heading | escape | newline_to_br }}</h2>{%- endif -%}
          </div>
          {%- if section.settings.text != blank -%}<p class="sn-head__text">{{ section.settings.text | escape }}</p>{%- endif -%}
        </div>
      {%- endif -%}

      <sn-box-picker class="sn-picker">
        {%- liquid
          assign first = null
          assign n = 0
          assign start = section.settings.start | plus: 0
          for block in section.blocks
            if block.settings.product != blank or request.design_mode
              assign n = n | plus: 1
              if first == null or n == start
                assign first = block
                assign first_idx = forloop.index
              endif
            endif
          endfor
          assign first_label = first.settings.label | default: first.settings.size | upcase
        -%}
        <div class="sn-pick-stage" data-stage style="--glow: {{ first.settings.glow | default: 'rgba(79,210,94,.38)' }};">
          {%- if first.settings.tag != blank -%}<span class="sn-pick-stage__badge" data-badge>{{ first.settings.tag | escape }}</span>{%- else -%}<span class="sn-pick-stage__badge" data-badge hidden></span>{%- endif -%}
          {%- if section.settings.stage_hint != blank -%}<span class="sn-pick-stage__tap">{{ section.settings.stage_hint | escape }}</span>{%- endif -%}
          <div class="sn-pick-stage__word" data-word aria-hidden="true">{{ first_label | escape }}</div>
          {%- capture scene_attrs -%}data-start="-34" tabindex="0" role="button" aria-label="{{ section.settings.stage_hint | default: 'Box öffnen' | escape }}"{%- endcapture -%}
          {%- render 'schnappy-3d-box', size: first.settings.size, label: first_label, pops: true, class: 'sn-drag sn-tween', attrs: scene_attrs -%}
        </div>

        <div class="sn-pick-panel">
          {%- if visible > 1 -%}
            <div class="sn-tabs" role="tablist" aria-label="{{ section.settings.heading | escape }}" style="--n: {{ visible }};">
              {%- for block in section.blocks -%}
                {%- if block.settings.product == blank and request.design_mode == false -%}{%- continue -%}{%- endif -%}
                {%- liquid
                  assign label = block.settings.label | default: block.settings.size | upcase
                  case block.settings.size
                    when 's'
                      assign dims = '150,112,124'
                    when 'xxl'
                      assign dims = '230,174,192'
                    else
                      assign dims = '186,140,154'
                  endcase
                -%}
                <button
                  type="button"
                  class="sn-tab"
                  role="tab"
                  id="SnTab-{{ block.id }}"
                  aria-controls="SnPanel-{{ block.id }}"
                  aria-selected="{% if forloop.index == first_idx %}true{% else %}false{% endif %}"
                  {% unless forloop.index == first_idx %}tabindex="-1"{% endunless %}
                  data-dims="{{ dims }}"
                  data-label="{{ label | escape }}"
                  data-tag="{{ block.settings.tag | escape }}"
                  data-glow="{{ block.settings.glow | default: 'rgba(79,210,94,.38)' }}"
                >
                  {{- label | escape -}}
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- for block in section.blocks -%}
            {%- assign box = block.settings.product -%}
            {%- if box == blank and request.design_mode == false -%}{%- continue -%}{%- endif -%}
            <div
              class="sn-pick-body"
              id="SnPanel-{{ block.id }}"
              {% if visible > 1 %}role="tabpanel" aria-labelledby="SnTab-{{ block.id }}"{% endif %}
              {% unless forloop.index == first_idx %}hidden{% endunless %}
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.tag != blank -%}<span class="sn-pick-tag">{{ block.settings.tag | escape }}</span>{%- endif -%}
              <h3 class="sn-pick-name">
                {%- if box != blank -%}
                  <a href="{{ box.url }}">{{ block.settings.title | default: box.title | escape }}</a>
                {%- else -%}
                  {{ block.settings.title | default: 'Mystery Box' | escape }}
                {%- endif -%}
              </h3>
              {%- if block.settings.description != blank -%}<p class="sn-pick-desc">{{ block.settings.description | escape }}</p>{%- endif -%}

              {%- if box != blank -%}
                {%- assign v = box.selected_or_first_available_variant -%}
                <div class="sn-pick-price">
                  <b>{{ v.price | money }}</b>
                  {%- if v.compare_at_price > v.price -%}
                    {%- assign save = v.compare_at_price | minus: v.price | times: 100 | divided_by: v.compare_at_price -%}
                    <s><span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>{{ section.settings.compare_prefix | escape }} {{ v.compare_at_price | money }}</s>
                    {%- if save > 0 -%}<span class="sn-save">−{{ save }} %</span>{%- endif -%}
                  {%- endif -%}
                </div>
                {%- if section.settings.tax_note != blank -%}<p class="sn-pick-tax">{{ section.settings.tax_note | escape }}</p>{%- endif -%}
              {%- else -%}
                <p class="sn-note">Theme-Editor: Wähle für diesen Block ein Produkt aus. Ohne Produkt wird die Box im Shop ausgeblendet.</p>
              {%- endif -%}

              {%- if block.settings.value > 0 -%}
                {%- liquid
                  assign max_cents = block.settings.value | times: 108
                  assign value_pct = 9259 | divided_by: 100.0
                  assign price_pct = 0
                  if box != blank
                    assign price_pct = v.price | times: 100.0 | divided_by: max_cents | at_most: 100
                  endif
                -%}
                <div class="sn-meter">
                  <div class="sn-meter__top"><span>{{ section.settings.meter_label | escape }}</span><b>{{ section.settings.meter_prefix | escape }} {{ block.settings.value }} €</b></div>
                  <div class="sn-meter__bar" aria-hidden="true"><i style="width: {{ value_pct }}%"></i><em style="width: {{ price_pct }}%"></em></div>
                  <div class="sn-meter__legend"><span style="--c: var(--sn-ink)">{{ section.settings.meter_price_label | escape }}</span><span style="--c: var(--sn-green)">{{ section.settings.meter_value_label | escape }}</span></div>
                </div>
              {%- endif -%}

              {%- if block.settings.points != blank -%}
                {%- assign points = block.settings.points | newline_to_br | split: '<br />' -%}
                <ul class="sn-incl">
                  {%- for pt in points -%}
                    {%- assign t = pt | strip -%}
                    {%- if t != blank -%}<li>{% render 'schnappy-icon', icon: 'shield-check' %}<span>{{ t | escape }}</span></li>{%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}

              <div class="sn-pick-cta">
                {%- if box != blank -%}
                  {%- assign form_id = 'sn-box-form-' | append: section.id | append: '-' | append: block.id -%}
                  <product-form data-section-id="{{ section.id }}">
                    {%- form 'product', box, id: form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                      <input type="hidden" name="id" value="{{ v.id }}" class="product-variant-id"{% unless v.available %} disabled{% endunless %}>
                      <div class="product-form__error-message-wrapper" role="alert" hidden>
                        <span class="product-form__error-message"></span>
                      </div>
                      <button
                        id="{{ form_id }}-submit"
                        type="submit"
                        name="add"
                        class="button button--full-width sn-btn-ink"
                        aria-haspopup="dialog"
                        {% unless v.available %}
                          disabled
                        {% endunless %}
                      >
                        <span>
                          {%- if v.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
                        </span>
                        <span class="sold-out-message hidden">{{ 'products.product.sold_out' | t }}</span>
                        {%- render 'loading-spinner' -%}
                      </button>
                    {%- endform -%}
                  </product-form>
                {%- endif -%}
                {%- if section.settings.meta_1 != blank or section.settings.meta_2 != blank -%}
                  <div class="sn-pick-meta">
                    {%- if section.settings.meta_1 != blank -%}<span>{% render 'schnappy-icon', icon: 'truck' %}{{ section.settings.meta_1 | escape }}</span>{%- endif -%}
                    {%- if section.settings.meta_2 != blank -%}<span>{% render 'schnappy-icon', icon: 'rotate-ccw' %}{{ section.settings.meta_2 | escape }}</span>{%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      </sn-box-picker>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Schnappy Mystery Boxen",
  "tag": "section",
  "class": "section",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kleine Überschrift", "default": "Der Klassiker" },
    { "type": "textarea", "id": "heading", "label": "Überschrift", "default": "Wähl deine Box." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Drei Größen, ein Versprechen: Der Warenwert liegt immer deutlich über dem Preis. Was genau drin ist, bleibt eine Überraschung." },
    { "type": "text", "id": "stage_hint", "label": "Hinweis auf der Bühne", "default": "Antippen zum Öffnen" },
    {
      "type": "select", "id": "start", "label": "Beim Laden ausgewählte Box", "default": "2",
      "options": [
        { "value": "1", "label": "1. Box" },
        { "value": "2", "label": "2. Box" },
        { "value": "3", "label": "3. Box" }
      ]
    },
    { "type": "header", "content": "Texte im Auswahl-Feld" },
    { "type": "text", "id": "compare_prefix", "label": "Vor dem Streichpreis", "default": "Wert" },
    { "type": "text", "id": "tax_note", "label": "Preis-Hinweis", "default": "inkl. MwSt., zzgl. Versand" },
    { "type": "text", "id": "meter_label", "label": "Wert-Anzeige: Titel", "default": "Garantierter Warenwert" },
    { "type": "text", "id": "meter_prefix", "label": "Wert-Anzeige: vor dem Betrag", "default": "mind." },
    { "type": "text", "id": "meter_price_label", "label": "Wert-Anzeige: Legende Preis", "default": "Dein Preis" },
    { "type": "text", "id": "meter_value_label", "label": "Wert-Anzeige: Legende Warenwert", "default": "Mindest-Warenwert" },
    { "type": "text", "id": "meta_1", "label": "Hinweis 1 unter dem Button", "default": "Versand in 24 h" },
    { "type": "text", "id": "meta_2", "label": "Hinweis 2 unter dem Button", "default": "14 Tage Widerruf" },
    { "type": "text", "id": "anchor", "label": "Sprungmarke", "default": "boxen", "info": "Damit Links wie /#boxen direkt hierher springen (z. B. in der App-Leiste)." },
    { "type": "header", "content": "Design" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Farbschema", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Abstand oben", "default": 32 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Abstand unten", "default": 96 }
  ],
  "blocks": [
    {
      "type": "box",
      "name": "Box",
      "settings": [
        { "type": "product", "id": "product", "label": "Produkt", "info": "Pflicht. Preis, Streichpreis (= Warenwert) und Verfügbarkeit kommen automatisch aus dem Produkt. Ohne Produkt wird die Box im Shop nicht angezeigt." },
        { "type": "text", "id": "label", "label": "Reiter-Beschriftung", "default": "M", "info": "Kurz, z. B. S, M oder XXL. Steht auch auf der 3D-Box." },
        {
          "type": "select", "id": "size", "label": "Größe der 3D-Box", "default": "m",
          "options": [
            { "value": "s", "label": "Klein (S)" },
            { "value": "m", "label": "Mittel (M)" },
            { "value": "xxl", "label": "Groß (XXL)" }
          ]
        },
        { "type": "text", "id": "title", "label": "Titel (optional)", "info": "Leer lassen = Produktname" },
        { "type": "text", "id": "tag", "label": "Etikett", "default": "BESTSELLER" },
        { "type": "textarea", "id": "description", "label": "Beschreibung", "default": "Unser Bestseller. Die goldene Mitte aus Menge, Marken und Überraschung." },
        { "type": "number", "id": "value", "label": "Garantierter Mindest-Warenwert in €", "default": 90, "info": "Für die Wert-Anzeige. 0 = Anzeige ausblenden. Nur echte, belegbare Werte angeben." },
        { "type": "textarea", "id": "points", "label": "Inhalt (eine Zeile pro Punkt)", "default": "10–15 Überraschungs-Artikel\nMindestens 1 Markenprodukt\nTrend-Produkte inklusive" },
        { "type": "color", "id": "glow", "label": "Farbe des Lichtscheins", "default": "#8E6CFF" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Schnappy Mystery Boxen",
      "blocks": [
        { "type": "box", "settings": { "label": "S", "size": "s", "tag": "EINSTEIGER", "title": "Mystery Box S", "value": 40, "glow": "#4FD25E", "description": "Der perfekte Einstieg in die Schnappy-Welt. Klein, aber mit ordentlich Biss.", "points": "5–8 Überraschungs-Artikel\nSpielzeug, Gadgets und Lifestyle\nIdeal als Geschenk" } },
        { "type": "box", "settings": { "label": "M", "size": "m", "tag": "BESTSELLER", "title": "Mystery Box M", "value": 90, "glow": "#8E6CFF" } },
        { "type": "box", "settings": { "label": "XXL", "size": "xxl", "tag": "AUS DER LIVE-SHOW", "title": "XXL Super Mystery Box", "value": 200, "glow": "#FFD21F", "description": "Die Legende aus der Live-Show. Randvoll gepackt, mit garantiertem Highlight.", "points": "20+ Artikel, randvoll gepackt\nGarantiertes Highlight-Produkt\nChance auf ein Jackpot-Item" } }
      ]
    }
  ]
}
{% endschema %}
