{%- comment -%} Schnappy: flexible Info-Seite (Über uns, Live-Shows, Versand, Kontakt-Infos) {%- endcomment -%}
<div class="page-width sn-info">
  {%- if section.settings.heading != blank -%}
    <div class="sn-info__head">
      {%- if section.settings.show_croc -%}<img src="{{ 'schnappy-sticker.png' | asset_url }}" alt="" width="348" height="389" class="sn-info__croc" loading="lazy">{%- endif -%}
      <div>
        {%- if section.settings.kicker != blank -%}<p class="sn-info__kicker">{{ section.settings.kicker | escape }}</p>{%- endif -%}
        <h1 class="sn-info__title">{{ section.settings.heading | escape }}</h1>
        {%- if section.settings.text != blank -%}<div class="sn-info__text rte">{{ section.settings.text }}</div>{%- endif -%}
      </div>
    </div>
  {%- endif -%}
  {%- if section.blocks.size > 0 -%}
    <div class="sn-info__grid">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'card' -%}
            <div class="sn-info__card" {{ block.shopify_attributes }}>
              <span class="sn-info__ic">{% render 'schnappy-icon', icon: block.settings.icon %}</span>
              <h2>{{ block.settings.title | escape }}</h2>
              <div class="rte">{{ block.settings.body }}</div>
            </div>
          {%- when 'row' -%}
            <div class="sn-info__row" {{ block.shopify_attributes }}><span>{{ block.settings.left | escape }}</span><b>{{ block.settings.right | escape }}</b></div>
          {%- when 'social' -%}
            <div class="sn-info__social" {{ block.shopify_attributes }}><h2>{{ block.settings.title | escape }}</h2>{% render 'schnappy-social' %}</div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>
{% schema %}
{
  "name": "Schnappy Info-Seite",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "checkbox", "id": "show_croc", "label": "Krokodil zeigen", "default": true },
    { "type": "text", "id": "kicker", "label": "Kleine Überschrift" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Über Schnappy" },
    { "type": "richtext", "id": "text", "label": "Text" }
  ],
  "blocks": [
    { "type": "card", "name": "Karte", "settings": [
      { "type": "select", "id": "icon", "label": "Symbol", "default": "star", "options": [ { "value": "star", "label": "Stern" }, { "value": "truck", "label": "Versand" }, { "value": "rotate-ccw", "label": "Rückgabe" }, { "value": "shield-check", "label": "Sicher" }, { "value": "radio", "label": "Live" }, { "value": "gift", "label": "Geschenk" }, { "value": "mail", "label": "E-Mail" }, { "value": "phone", "label": "Telefon" }, { "value": "heart", "label": "Herz" }, { "value": "package", "label": "Paket" } ] },
      { "type": "text", "id": "title", "label": "Titel", "default": "Titel" },
      { "type": "richtext", "id": "body", "label": "Text", "default": "<p>Text</p>" }
    ] },
    { "type": "row", "name": "Tabellenzeile", "settings": [
      { "type": "text", "id": "left", "label": "Links", "default": "Deutschland" },
      { "type": "text", "id": "right", "label": "Rechts", "default": "4,90 €" }
    ] },
    { "type": "social", "name": "Social-Kacheln", "settings": [ { "type": "text", "id": "title", "label": "Titel", "default": "Folge uns" } ] }
  ],
  "presets": [{ "name": "Schnappy Info-Seite" }]
}
{% endschema %}
