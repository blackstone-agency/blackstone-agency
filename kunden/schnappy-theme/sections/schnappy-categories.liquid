{%- comment -%} Schnappy: Kategorie-Kacheln mit Symbol {%- endcomment -%}
<div id="kategorien" class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width sn-cats" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
    {%- if section.settings.heading != blank -%}
      <div class="sn-shophead"><h2 class="h2">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.all_label != blank -%}<a href="{{ routes.all_products_collection_url }}" class="sn-shophead__link">{{ section.settings.all_label | escape }} →</a>{%- endif -%}
      </div>
    {%- endif -%}
    <ul class="sn-cats__grid" role="list">
      {%- for block in section.blocks -%}
        {%- capture href -%}{% render 'schnappy-cat-href', link: block.settings.link, q: block.settings.q, label: block.settings.label %}{%- endcapture -%}
        <li {{ block.shopify_attributes }}>
          <a href="{{ href }}" class="sn-cats__tile" style="--c: {{ block.settings.color }};">
            {%- liquid
              assign cat_img = blank
              if block.settings.image == blank and section.settings.photos
                assign kw = block.settings.match | default: block.settings.label | downcase | split: ' ' | first | remove: '&'
                for p in collections.all.products limit: 50
                  unless p.featured_image
                    continue
                  endunless
                  if kw == 'neu'
                    assign cat_img = p.featured_image
                    break
                  elsif kw == 'angebote'
                    if p.compare_at_price > p.price
                      assign cat_img = p.featured_image
                      break
                    endif
                  else
                    assign hay = p.title | append: ' ' | append: p.type | append: ' ' | downcase
                    assign tg = p.tags | join: ' ' | downcase
                    assign hay = hay | append: tg
                    if hay contains kw
                      assign cat_img = p.featured_image
                      break
                    endif
                  endif
                endfor
              endif
            -%}
            <span class="sn-cats__icon{% if cat_img != blank or block.settings.image != blank %} sn-cats__icon--photo{% endif %}">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: '', widths: '120, 240' }}
              {%- elsif cat_img != blank -%}
                {{ cat_img | image_url: width: 240 | image_tag: loading: 'lazy', alt: '', widths: '120, 240' }}
              {%- else -%}
                {% render 'schnappy-icon', icon: block.settings.icon %}
              {%- endif -%}
            </span>
            <span class="sn-cats__label">{{ block.settings.label | escape }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
    {%- if section.settings.brands != blank -%}
      {%- assign brands = section.settings.brands | split: ',' -%}
      <nav class="sn-brands" aria-label="Marken">
        <span class="sn-brands__label">Top-Marken:</span>
        {%- for b in brands -%}{%- assign bt = b | strip -%}{%- if bt != blank -%}<a href="{{ routes.search_url }}?type=product&q={{ bt | url_encode }}">{{ bt | escape }}</a>{%- endif -%}{%- endfor -%}
      </nav>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Schnappy Kategorien",
  "tag": "section",
  "class": "section",
  "max_blocks": 16,
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Kategorien" },
    { "type": "text", "id": "all_label", "label": "Link rechts", "default": "Alle Produkte" },
    { "type": "checkbox", "id": "photos", "label": "Automatisch Produktfotos statt Symbole", "default": true, "info": "Sucht pro Kategorie ein passendes Produkt (Titel, Produkttyp oder Tag)." },
    { "type": "text", "id": "brands", "label": "Top-Marken (mit Komma)", "default": "Disney,Pokémon,Harry Potter,Fisher-Price,Clementoni,Happy Socks,Stitch" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Farbschema", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Abstand oben", "default": 28 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Abstand unten", "default": 12 }
  ],
  "blocks": [
    { "type": "cat", "name": "Kategorie", "settings": [
      { "type": "text", "id": "label", "label": "Name", "default": "Spielzeug" },
      { "type": "url", "id": "link", "label": "Link", "info": "Am besten eine Kollektion wählen. Leer = Suche nach dem Namen." },
      { "type": "text", "id": "q", "label": "Suchbegriff oder Pfad", "info": "Optional, wenn kein Link gesetzt ist. Z. B. product_type:\"Mystery Box\" oder /collections/all?sort_by=created-descending" },
      { "type": "select", "id": "icon", "label": "Symbol", "default": "toy-brick", "options": [
        { "value": "toy-brick", "label": "Spielzeug" }, { "value": "gamepad-2", "label": "Gaming" }, { "value": "headphones", "label": "Elektronik" },
        { "value": "cooking-pot", "label": "Küche" }, { "value": "coffee", "label": "Kaffee/Haushalt" }, { "value": "lamp", "label": "Wohnen" },
        { "value": "flame", "label": "Trend" }, { "value": "gift", "label": "Geschenke" }, { "value": "package", "label": "Mystery Box" },
        { "value": "baby", "label": "Baby & Kind" }, { "value": "heart", "label": "Beauty" }, { "value": "star", "label": "Angebote" },
        { "value": "cup-soda", "label": "Trinken" }, { "value": "car", "label": "Auto" }, { "value": "cat", "label": "Tier" }, { "value": "sparkles", "label": "Neu" }
      ] },
      { "type": "color", "id": "color", "label": "Farbe", "default": "#FF7A4D" },
      { "type": "image_picker", "id": "image", "label": "Eigenes Bild statt Symbol (optional)" },
      { "type": "text", "id": "match", "label": "Suchwort fürs Foto (optional)", "info": "Standard: erstes Wort des Namens. Spezial: neu, angebote." }
    ] }
  ],
  "presets": [{ "name": "Schnappy Kategorien" }]
}
{% endschema %}
