{%- comment -%} Schnappy: Angebots-Banner (1 groß + 2 klein) {%- endcomment -%}
<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width sn-promos" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
    {%- for block in section.blocks -%}
      {%- if block.settings.show_box -%}{%- assign fb = '#boxen' -%}{%- else -%}{%- assign fb = routes.all_products_collection_url -%}{%- endif -%}
      <a href="{{ block.settings.link | default: fb }}" class="sn-promo sn-promo--{{ block.settings.style }}{% if forloop.first %} sn-promo--big{% endif %}" {{ block.shopify_attributes }}>
        <span class="sn-promo__text">
          {%- if block.settings.badge != blank -%}<span class="sn-promo__badge">{{ block.settings.badge | escape }}</span>{%- endif -%}
          <span class="sn-promo__title">{{ block.settings.title | escape }}</span>
          {%- if block.settings.text != blank -%}<span class="sn-promo__sub">{{ block.settings.text | escape }}</span>{%- endif -%}
          <span class="sn-promo__cta">{{ block.settings.cta | escape }} →</span>
        </span>
        <span class="sn-promo__media" aria-hidden="true">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'eager', widths: '300, 600, 900', alt: '' }}
          {%- elsif block.settings.show_box -%}
            {% render 'schnappy-3d-box', size: 'm', label: 'Box', class: 'sn-promo__box' %}
          {%- else -%}
            <span class="sn-promo__icon">{% render 'schnappy-icon', icon: block.settings.icon %}</span>
          {%- endif -%}
        </span>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Schnappy Angebote",
  "tag": "section",
  "class": "section",
  "max_blocks": 3,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Farbschema", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Abstand oben", "default": 20 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Abstand unten", "default": 8 }
  ],
  "blocks": [
    { "type": "promo", "name": "Banner", "settings": [
      { "type": "text", "id": "badge", "label": "Etikett", "default": "Neu" },
      { "type": "text", "id": "title", "label": "Titel", "default": "Mystery Boxen" },
      { "type": "text", "id": "text", "label": "Text", "default": "Ab 19,99 € – immer mehr Warenwert als Preis" },
      { "type": "text", "id": "cta", "label": "Button-Text", "default": "Jetzt ansehen" },
      { "type": "url", "id": "link", "label": "Link" },
      { "type": "select", "id": "style", "label": "Farbe", "default": "green", "options": [
        { "value": "green", "label": "Dunkelgrün" }, { "value": "yellow", "label": "Gelb" }, { "value": "red", "label": "Rot" }, { "value": "ink", "label": "Schwarz" } ] },
      { "type": "image_picker", "id": "image", "label": "Bild (optional)" },
      { "type": "checkbox", "id": "show_box", "label": "3D-Mystery-Box zeigen (ohne Bild)", "default": false },
      { "type": "select", "id": "icon", "label": "Symbol (ohne Bild/Box)", "default": "flame", "options": [
        { "value": "flame", "label": "Flamme" }, { "value": "radio", "label": "Live" }, { "value": "gift", "label": "Geschenk" }, { "value": "star", "label": "Stern" }, { "value": "truck", "label": "Versand" }, { "value": "sparkles", "label": "Neu" } ] }
    ] }
  ],
  "presets": [{ "name": "Schnappy Angebote" }]
}
{% endschema %}
