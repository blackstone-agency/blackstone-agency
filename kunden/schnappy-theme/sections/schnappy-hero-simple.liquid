{%- comment -%}
  Schnappy Hero (schlicht): Überschrift, ein Button zu allen Produkten, drei Vorteile.
  „Bis zu −X %“ wird aus den echten Streichpreisen berechnet.
{%- endcomment -%}
{%- liquid
  assign max_pct = 0
  for p in collections.all.products limit: 50
    if p.compare_at_price > p.price
      assign pct = p.compare_at_price | minus: p.price | times: 100 | divided_by: p.compare_at_price
      if pct > max_pct
        assign max_pct = pct
      endif
    endif
  endfor
-%}
<div class="sn-hs-wrap color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="sn-hs">
      <div class="sn-hs__copy">
        {%- if section.settings.kicker != blank -%}
          <p class="sn-hs__kicker">{{ section.settings.kicker | escape }}</p>
        {%- endif -%}
        <h1 class="sn-hs__title">{{ section.settings.heading | escape }}</h1>
        <p class="sn-hs__sub">
          {%- if max_pct >= 20 -%}<b>Bis zu −{{ max_pct }} %</b> {% endif -%}
          {{- section.settings.subheading | escape -}}
        </p>
        <div class="sn-hs__actions">
          <a class="sn-hs__btn" href="#produkte">{{ section.settings.button_label | escape }}</a>
          {%- if section.settings.link_label != blank -%}
            <a class="sn-hs__link" href="{{ section.settings.link_url | default: '/search?type=product&q=product_type%3A%22Mystery+Box%22' }}">
              {{- section.settings.link_label | escape }} →</a>
          {%- endif -%}
        </div>
        <ul class="sn-hs__usp" role="list">
          <li>{% render 'schnappy-icon', icon: 'truck' %}Gratis Versand ab 44 €</li>
          <li>{% render 'schnappy-icon', icon: 'zap' %}Versand in 1–2 Werktagen</li>
          <li>{% render 'schnappy-icon', icon: 'rotate-ccw' %}14 Tage Rückgabe</li>
        </ul>
      </div>
      <div class="sn-hs__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 520 | image_tag: loading: 'eager', width: 260, alt: '' }}
        {%- else -%}
          <img src="{{ 'schnappy-mark.png' | asset_url }}" alt="" width="260" height="218" loading="eager">
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Schnappy Hero schlicht",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kleine Überschrift", "default": "Markenware zu Restpostenpreisen" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Schnapp dir die besten Deals." },
    { "type": "text", "id": "subheading", "label": "Text", "default": "auf Spielzeug, Haushalt & Elektronik – jeden Tag neue Ware." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Alle Produkte ansehen" },
    { "type": "text", "id": "link_label", "label": "Zweiter Link (Text)", "default": "Mystery Box ab 9,99 €" },
    { "type": "url", "id": "link_url", "label": "Zweiter Link (Ziel)", "info": "Leer = Mystery Boxen" },
    { "type": "image_picker", "id": "image", "label": "Bild rechts (ab Tablet)", "info": "Leer = Schnappy-Maskottchen" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Farbschema", "default": "scheme-1" }
  ],
  "presets": [{ "name": "Schnappy Hero schlicht" }]
}
{% endschema %}
