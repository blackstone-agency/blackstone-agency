{%- comment -%} Schnappy: feste Footer-Spalten (Shop, Hilfe, Rechtliches, Kontakt) {%- endcomment -%}
<div class="footer-block grid__item sn-fcol">
  <h2 class="footer-block__heading">Shop</h2>
  <ul class="list-unstyled">
    <li><a href="{{ routes.all_products_collection_url }}?sort_by=created-descending">Neu eingetroffen</a></li>
    <li><a href="{{ routes.root_url }}#boxen">Mystery Boxen</a></li>
