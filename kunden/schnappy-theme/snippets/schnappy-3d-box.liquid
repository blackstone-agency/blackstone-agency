{%- comment -%}
  Schnappy: 3D-Mystery-Box aus CSS (kein Bild nötig). JS: assets/schnappy.js (<sn-scene>).
  Parameter:
  - size: 's' | 'm' | 'xxl' (Standard 'm')
  - label: Aufschrift auf dem Etikett, z. B. 'XXL'
  - pops: true = beim Öffnen fliegen Mini-Pakete heraus (mit Lichtschein)
  - class: zusätzliche CSS-Klassen
  - attrs: zusätzliche HTML-Attribute für <sn-scene>
{%- endcomment -%}
{%- liquid
  assign size = size | default: 'm'
  case size
    when 's'
      assign bw = 150
      assign bh = 112
      assign bd = 124
    when 'xxl'
      assign bw = 230
      assign bh = 174
      assign bd = 192
    else
      assign bw = 186
      assign bh = 140
      assign bd = 154
  endcase
  assign word = settings.sn_brand_word | default: shop.name | upcase | escape
-%}
<sn-scene class="sn-scene{% if class %} {{ class }}{% endif %}" style="--bw:{{ bw }};--bh:{{ bh }};--bd:{{ bd }};" {{ attrs }}>
  <div class="sn-cube sn-mbox">
    <div class="sn-f sn-f-back"></div>
    <div class="sn-f sn-f-left"></div>
    <div class="sn-f sn-f-bottom"></div>
    {%- if pops -%}
      <div class="sn-beam"></div>
      <div class="sn-beam sn-beam--2"></div>
      <span class="sn-pop" style="--x:-.4;--y:-.62;--r:-12deg;--dl:.12s"><span class="sn-cube sn-mini" style="--s:1.12;--tone:var(--sn-toy);--ry:-28deg"><span class="sn-f sn-f-back"></span><span class="sn-f sn-f-left"></span><span class="sn-f sn-f-bottom"></span><span class="sn-f sn-f-top"></span><span class="sn-f sn-f-right"></span><span class="sn-f sn-f-front"><i>S</i>{% render 'schnappy-icon', icon: 'rabbit' %}</span></span></span>
      <span class="sn-pop" style="--x:.03;--y:-1.02;--r:5deg;--dl:.2s"><span class="sn-cube sn-mini" style="--s:.92;--tone:var(--sn-tech);--ry:22deg"><span class="sn-f sn-f-back"></span><span class="sn-f sn-f-left"></span><span class="sn-f sn-f-bottom"></span><span class="sn-f sn-f-top"></span><span class="sn-f sn-f-right"></span><span class="sn-f sn-f-front"><i>S</i>{% render 'schnappy-icon', icon: 'headphones' %}</span></span></span>
      <span class="sn-pop" style="--x:.42;--y:-.6;--r:13deg;--dl:.28s"><span class="sn-cube sn-mini" style="--s:1;--tone:var(--sn-trend);--ry:-18deg"><span class="sn-f sn-f-back"></span><span class="sn-f sn-f-left"></span><span class="sn-f sn-f-bottom"></span><span class="sn-f sn-f-top"></span><span class="sn-f sn-f-right"></span><span class="sn-f sn-f-front"><i>S</i>{% render 'schnappy-icon', icon: 'projector' %}</span></span></span>
      <span class="sn-pop" style="--x:-.2;--y:-1.45;--r:-9deg;--dl:.36s"><span class="sn-cube sn-mini" style="--s:.82;--tone:var(--sn-green);--ry:30deg"><span class="sn-f sn-f-back"></span><span class="sn-f sn-f-left"></span><span class="sn-f sn-f-bottom"></span><span class="sn-f sn-f-top"></span><span class="sn-f sn-f-right"></span><span class="sn-f sn-f-front"><i>S</i>{% render 'schnappy-icon', icon: 'gamepad-2' %}</span></span></span>
      <span class="sn-pop" style="--x:.26;--y:-1.36;--r:15deg;--dl:.44s"><span class="sn-cube sn-mini" style="--s:.78;--tone:var(--sn-home);--on:var(--sn-ink);--ry:-34deg"><span class="sn-f sn-f-back"></span><span class="sn-f sn-f-left"></span><span class="sn-f sn-f-bottom"></span><span class="sn-f sn-f-top"></span><span class="sn-f sn-f-right"></span><span class="sn-f sn-f-front"><i>S</i>{% render 'schnappy-icon', icon: 'lamp' %}</span></span></span>
      <span class="sn-spark" style="--sx:-.6;--sy:-1.3;--sd:0s"></span>
      <span class="sn-spark" style="--sx:.55;--sy:-1.4;--sd:.4s"></span>
      <span class="sn-spark" style="--sx:-.2;--sy:-1.9;--sd:.8s"></span>
      <span class="sn-spark" style="--sx:.3;--sy:-1.8;--sd:1.2s"></span>
      <span class="sn-spark" style="--sx:-.75;--sy:-.7;--sd:1.6s"></span>
      <span class="sn-spark" style="--sx:.8;--sy:-.8;--sd:2s"></span>
    {%- endif -%}
    <div class="sn-f sn-f-right"></div>
    <div class="sn-f sn-f-front">
      <div class="sn-tape"><span>{{ word }} {{ word }}</span></div>
      <div class="sn-label">
        <span class="sn-label__brand">{{ word }}</span>
        <span class="sn-label__q">?</span>
        <span class="sn-label__tier">Mystery · <span data-sn-label>{{ label | escape }}</span></span>
      </div>
    </div>
    <div class="sn-f sn-lid"><div class="sn-tape"><span>{{ word }} {{ word }}</span></div></div>
  </div>
  <div class="sn-ground"></div>
</sn-scene>
