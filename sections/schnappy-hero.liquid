{%- comment -%} Schnappy: Startbereich (Hero) {%- endcomment -%}
<div class="sn-hero{% if section.settings.curve %} sn-hero--curve{% endif %} color-{{ section.settings.color_scheme }} gradient" style="--sn-curve-color: {{ section.settings.curve_color }};">
  <div class="page-width sn-hero__grid" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
    <div>
      {%- if section.settings.eyebrow != blank -%}
        <span class="sn-eyebrow"><span class="sn-dot"></span>{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      <h2 class="sn-hero__heading">
        {{- section.settings.heading | escape -}}
        {%- if section.settings.heading_highlight != blank %} <em>{{ section.settings.heading_highlight | escape }}</em>{% endif -%}
      </h2>
      {%- if section.settings.text != blank -%}
        <div class="sn-hero__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
      <div class="sn-hero__buttons">
        {%- if section.settings.button_label_1 != blank -%}
          <a href="{{ section.settings.button_link_1 | default: routes.all_products_collection_url }}" class="button button--primary">{{ section.settings.button_label_1 | escape }}</a>
        {%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}
          <a href="{{ section.settings.button_link_2 | default: routes.all_products_collection_url }}" class="button button--secondary">{{ section.settings.button_label_2 | escape }}</a>
        {%- endif -%}
      </div>
      {%- assign stats = section.blocks | where: 'type', 'stat' -%}
      {%- if stats.size > 0 -%}
        <div class="sn-hero__stats">
          {%- for block in stats -%}
            <div {{ block.shopify_attributes }}><b>{{ block.settings.value | escape }}</b>{{ block.settings.label | escape }}</div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
    <div class="sn-hero__visual">
      <div class="sn-hero__glow"></div>
      <div class="sn-hero__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 990px) 340px, 64vw', widths: '340, 500, 680, 900', alt: section.settings.image.alt }}
        {%- else -%}
          {%- render 'schnappy-mascot' -%}
        {%- endif -%}
      </div>
      {%- for block in section.blocks -%}
        {%- if block.type == 'sticker' -%}
          <div class="sn-sticker sn-sticker--{{ block.settings.position }}" {{ block.shopify_attributes }}>
            {{ block.settings.icon | escape }}
            <span>{{ block.settings.title | escape }}<small>{{ block.settings.subtitle | escape }}</small></span>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Schnappy Startbereich",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kleiner Hinweis oben", "default": "Bekannt aus den Whatnot Live-Shows" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Schnapp dir die" },
    { "type": "text", "id": "heading_highlight", "label": "Hervorgehobenes Wort (gelb)", "default": "Deals." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Mystery Boxen, Trend-Produkte und Spielzeug direkt aus unserem Lager – jetzt auch rund um die Uhr bestellbar.</p>" },
    { "type": "image_picker", "id": "image", "label": "Bild / Maskottchen", "info": "Am besten PNG mit transparentem Hintergrund. Ohne Bild wird das Schnappy-Krokodil angezeigt." },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "button_label_1", "label": "Button 1 Text", "default": "Mystery Box sichern" },
    { "type": "url", "id": "button_link_1", "label": "Button 1 Link" },
    { "type": "text", "id": "button_label_2", "label": "Button 2 Text", "default": "Alle Deals" },
    { "type": "url", "id": "button_link_2", "label": "Button 2 Link" },
    { "type": "header", "content": "Design" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Farbschema", "default": "scheme-3" },
    { "type": "checkbox", "id": "curve", "label": "Runder Übergang unten", "default": true },
    { "type": "color", "id": "curve_color", "label": "Farbe des Übergangs", "default": "#FFF9EC", "info": "Sollte der Hintergrundfarbe der nächsten Sektion entsprechen." },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Abstand oben", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Abstand unten", "default": 88 }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Kennzahl",
      "settings": [
        { "type": "text", "id": "value", "label": "Wert", "default": "1.000+" },
        { "type": "text", "id": "label", "label": "Beschriftung", "default": "Follower & Fans" }
      ]
    },
    {
      "type": "sticker",
      "name": "Sticker",
      "limit": 2,
      "settings": [
        { "type": "text", "id": "icon", "label": "Emoji", "default": "🔥" },
        { "type": "text", "id": "title", "label": "Titel", "default": "bis −70 %" },
        { "type": "text", "id": "subtitle", "label": "Untertitel", "default": "auf Trend-Produkte" },
        {
          "type": "select", "id": "position", "label": "Position", "default": "bottom-right",
          "options": [
            { "value": "top-left", "label": "Oben links" },
            { "value": "top-right", "label": "Oben rechts" },
            { "value": "bottom-left", "label": "Unten links" },
            { "value": "bottom-right", "label": "Unten rechts" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Schnappy Startbereich",
      "blocks": [
        { "type": "stat", "settings": { "value": "1.000+", "label": "Follower & Fans" } },
        { "type": "stat", "settings": { "value": "−70 %", "label": "unter UVP" } },
        { "type": "sticker", "settings": { "icon": "🔥", "title": "bis −70 %", "subtitle": "auf Trend-Produkte", "position": "bottom-right" } }
      ]
    }
  ]
}
{% endschema %}
