{%- comment -%} Schnappy: Laufband mit Aktionen (für den Header-Bereich) {%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  <div class="sn-ticker color-{{ section.settings.color_scheme }} gradient" style="--sn-speed: {{ section.settings.speed }}s;" role="region" aria-label="Aktionen">
    <div class="sn-ticker__track">
      {%- for i in (1..2) -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" {{ block.shopify_attributes }}{% if i == 2 %} aria-hidden="true" tabindex="-1"{% endif %}>{{ block.settings.text | escape }}</a>
          {%- else -%}
            <span {{ block.shopify_attributes }}{% if i == 2 %} aria-hidden="true"{% endif %}>{{ block.settings.text | escape }}</span>
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Schnappy Laufband",
  "class": "sn-ticker-section",
  "max_blocks": 8,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Farbschema", "default": "scheme-5" },
    { "type": "range", "id": "speed", "min": 10, "max": 60, "step": 2, "unit": "s", "label": "Geschwindigkeit (höher = langsamer)", "default": 30 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "🚚 Gratis Versand ab 49 €" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "enabled_on": { "groups": ["header"] },
  "presets": [
    {
      "name": "Schnappy Laufband",
      "blocks": [
        { "type": "item", "settings": { "text": "🚚 Gratis Versand ab 49 €" } },
        { "type": "item", "settings": { "text": "🔴 Live-Show heute 19:00 auf Whatnot" } }
      ]
    }
  ]
}
{% endschema %}
